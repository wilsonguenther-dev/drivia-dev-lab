---
// Flashcard quiz overlay. Three modes:
//   1. term → definition  (default)
//   2. definition → term
//   3. example → term
---
<div class="quiz-overlay" id="quiz-overlay" style="display:none">
  <div class="quiz-shell">
    <button class="quiz-close" data-act="quiz-close" title="Close (Esc)">✕</button>
    <div class="quiz-head">
      <span class="quiz-eye">FLASHCARDS</span>
      <span class="quiz-prog" id="quiz-prog">— / —</span>
    </div>
    <div class="quiz-modes" id="quiz-modes">
      <button class="quiz-mode active" data-mode="term-to-def">Term → Definition</button>
      <button class="quiz-mode" data-mode="def-to-term">Definition → Term</button>
      <button class="quiz-mode" data-mode="example-to-term">Example → Term</button>
    </div>
    <div class="quiz-card" id="quiz-card"></div>
    <div class="quiz-actions">
      <button class="quiz-btn" data-act="quiz-reveal" id="quiz-reveal">Reveal (Space)</button>
      <button class="quiz-btn ok" data-act="quiz-knew" id="quiz-knew" hidden>I knew it (J)</button>
      <button class="quiz-btn bad" data-act="quiz-missed" id="quiz-missed" hidden>Missed (F)</button>
      <button class="quiz-btn" data-act="quiz-skip">Skip (S)</button>
    </div>
    <div class="quiz-counter" id="quiz-counter">0 right · 0 missed</div>
  </div>
</div>

<style>
.quiz-overlay{position:fixed;inset:0;background:rgba(3,3,15,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;z-index:9999}
.quiz-shell{width:min(720px,92vw);max-height:90vh;overflow-y:auto;background:var(--panel);border:1px solid var(--line);padding:32px 36px;position:relative}
.quiz-close{position:absolute;top:14px;right:18px;background:transparent;color:var(--muted);border:1px solid var(--line);font:700 13px/1 var(--mono);padding:6px 9px;cursor:pointer}
.quiz-close:hover{color:var(--accent-bad);border-color:var(--accent-bad)}
.quiz-head{display:flex;align-items:baseline;gap:14px;margin-bottom:18px}
.quiz-eye{font:700 11px/1 var(--mono);letter-spacing:.22em;color:var(--accent);text-transform:uppercase}
.quiz-prog{font:500 12px/1 var(--mono);color:var(--dim);font-variant-numeric:tabular-nums}
.quiz-modes{display:flex;gap:6px;margin-bottom:22px;flex-wrap:wrap}
.quiz-mode{background:transparent;color:var(--muted);border:1px solid var(--line);font:600 10px/1 var(--mono);letter-spacing:.08em;padding:6px 10px;cursor:pointer;text-transform:uppercase}
.quiz-mode.active{color:var(--accent);border-color:var(--accent);background:rgba(0,212,255,.06)}
.quiz-card{min-height:180px;padding:22px 24px;background:rgba(255,255,255,.02);border:1px solid var(--line);font:500 16px/1.5 var(--body);color:var(--ink);margin-bottom:18px}
.quiz-card .qprompt{font:700 11px/1 var(--mono);letter-spacing:.18em;color:var(--accent);text-transform:uppercase;margin-bottom:10px}
.quiz-card .qbody{font-size:18px;line-height:1.5}
.quiz-card .qanswer{margin-top:18px;padding-top:14px;border-top:1px dashed var(--line);font:700 22px/1.2 var(--type);color:var(--accent-warm)}
.quiz-actions{display:flex;gap:8px;flex-wrap:wrap}
.quiz-btn{background:transparent;color:var(--muted);border:1px solid var(--line);font:700 11px/1 var(--mono);letter-spacing:.08em;padding:9px 14px;cursor:pointer;text-transform:uppercase}
.quiz-btn:hover{color:var(--accent);border-color:var(--accent)}
.quiz-btn.ok{color:var(--accent-good);border-color:color-mix(in srgb,var(--accent-good) 50%,transparent)}
.quiz-btn.ok:hover{background:rgba(4,248,39,.08)}
.quiz-btn.bad{color:var(--accent-bad);border-color:color-mix(in srgb,var(--accent-bad) 50%,transparent)}
.quiz-btn.bad:hover{background:rgba(255,58,94,.06)}
.quiz-counter{margin-top:16px;font:500 12px/1 var(--mono);color:var(--dim)}
</style>
