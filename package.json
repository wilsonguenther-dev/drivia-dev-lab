{
  "name": "drivia-dev-lab",
  "version": "0.1.0",
  "private": false,
  "description": "Read \u00b7 Hear \u00b7 Speak \u00b7 Master \u2014 Drivia Developer Vocabulary lab. 16 chapters, 161 terms. Plain English \u00b7 analogy \u00b7 example \u00b7 when-to-use \u00b7 watch-out. Built on the Drivia Formula Lab v6 study-lab core.",
  "type": "module",
  "license": "MIT",
  "author": "Wilson Guenther <wilson@drivia.consulting>",
  "scripts": {
    "predev": "rm -rf node_modules/.vite .astro",
    "dev": "astro dev --port 4322",
    "build": "astro build",
    "preview": "astro preview --host --port 4322",
    "start": "node ./dist/server/entry.mjs",
    "parse-vocab": "tsx scripts/parse-vocab.ts",
    "check": "astro check",
    "audit": "tsx scripts/audit-terms.ts",
    "smoke": "tsx scripts/smoke.ts",
    "predeploy": "npm run check && npm run build && npm run audit"
  },
  "dependencies": {
    "@astrojs/node": "^9.1.3",
    "@astrojs/react": "^4.4.2",
    "astro": "5.7.6",
    "canvas-confetti": "1.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/canvas-confetti": "1.9.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "playwright": "^1.60.0",
    "tsx": "4.19.2",
    "typescript": "^5.9.3"
  }
}
